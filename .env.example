# Copy this file to .env and add ONE key to enable the "AI check" switch.
# Never share your .env file or include it when you send the project to someone.

# Google Gemini (has a free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Or Anthropic Claude (paid). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: when both keys are set, pick one ("gemini" or "anthropic").
# AI_PROVIDER=gemini

# Optional: the model used for the AI check.
# Defaults: gemini-3.5-flash for Gemini, claude-haiku-5-5 for Claude.
# AI_MODEL=gemini-3.5-flash

# Optional: reuse fetched pages for this many minutes, to make repeat lookups faster.
# 0 (the default) re-reads the shops on every lookup, so stock is always current.
# CACHE_MINUTES=0
